"""timegraft: dated barcode trees for phylogenetic diversity.

    records --filter--> representatives --shard by genus--> dated genus subtrees
    dated backbone ----------------------------------------> graft --> timegraft.tre
"""

from pathlib import Path

configfile: "config/config.yaml"

OUT = config["outdir"]
# the timegraft package, made importable for the rule scripts
SRC = str(Path(workflow.basedir).parent / "src")
SHARDS = list(range(int(config["n_shards"])))
BUILD_BACKBONE = bool(config.get("backbone_build", {}).get("enabled"))
USE_ASVS = bool(config.get("asvs") and config.get("asv_table"))
BACKBONE = f"{OUT}/backbone/backbone.tre" if BUILD_BACKBONE else config["backbone"]


include: "rules/tools.smk"
include: "rules/units.smk"
include: "rules/backbone.smk"
include: "rules/genus.smk"
include: "rules/graft.smk"
include: "rules/placement.smk"
include: "rules/diversity.smk"
include: "rules/validation.smk"


rule all:
    input:
        f"{OUT}/timegraft.tre",
        f"{OUT}/provenance.tsv",
        [f"{OUT}/diversity/alpha.tsv", f"{OUT}/diversity/beta.tsv"] if USE_ASVS or config.get("samples") else [],
        f"{OUT}/validation/summary.tsv" if config.get("validation", {}).get("reference_tree") else [],
